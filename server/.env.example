# Copy to server/.env for local development only.
# Production variables belong in Vercel -> Settings -> Environment Variables.
# Use a separate Supabase project for development.
# Supabase -> Connect -> Transaction pooler (6543), PostgreSQL URL, not HTTPS.
DATABASE_URL=
# Supabase -> Connect -> Session pooler (5432), used for migrations and seed.
DIRECT_URL=

JWT_SECRET=
CRON_SECRET=
CLIENT_URL=http://localhost:5173
PORT=5000
NODE_ENV=development

# Choose administrator credentials before the first seed.
# Production requires a password of at least 12 characters.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_DEMO=false

# Resend: verify aurumite.com and create a sending API key.
# Leave SMTP_PASS blank until configured.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM=enquires@aurumite.com
# Must be a real inbox that can receive mail. Resend sending does not create one.
SALES_EMAIL=

# Optional Stripe Checkout: leave blank until configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
